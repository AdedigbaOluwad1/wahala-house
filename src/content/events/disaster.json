[
  {
    "id": "flood_warning",
    "title": "Flood warning for {state}",
    "body": "Heavy rains are forecast and the rivers in {state} are rising. {governor} asks whether the federal government will act before the water arrives or after.",
    "tags": [
      "disaster",
      "flood",
      "seasonal"
    ],
    "scope": "state",
    "advisor": "health",
    "conditions": [
      {
        "type": "trait",
        "trait": "flood_prone"
      },
      {
        "type": "quarter",
        "quarters": [
          3,
          4
        ]
      }
    ],
    "baseProbability": 0.004,
    "cooldownTicks": 52,
    "severity": 2,
    "newsTemplateId": "ev.flood_warning",
    "choices": [
      {
        "id": "pre_emptive_relief",
        "label": "Pre-position relief and evacuate",
        "cost": 50,
        "effects": [
          {
            "kind": "stat",
            "target": "infrastructure",
            "scope": "$state",
            "delta": 3
          },
          {
            "kind": "stat",
            "target": "health",
            "scope": "$state",
            "delta": 2
          },
          {
            "kind": "stat",
            "target": "mood",
            "scope": "$state",
            "delta": 3
          }
        ],
        "newsTemplateId": "ev.flood_warning.pre_emptive_relief",
        "advisorReactions": {
          "health": "Prevention is always cheaper than treatment.",
          "finance": "Spend now to avoid spending three times as much later."
        }
      },
      {
        "id": "early_warning_only",
        "label": "Issue warnings only",
        "cost": 15,
        "effects": [
          {
            "kind": "stat",
            "target": "mood",
            "scope": "$state",
            "delta": 1
          },
          {
            "kind": "stat",
            "target": "infrastructure",
            "scope": "$state",
            "delta": 1
          }
        ],
        "newsTemplateId": "ev.flood_warning.early_warning_only",
        "advisorReactions": {
          "finance": "A cheap middle path.",
          "health": "Warnings help, but not without shelters."
        }
      },
      {
        "id": "ignore",
        "label": "Wait and see",
        "ignore": true,
        "effects": [
          {
            "kind": "stat",
            "target": "health",
            "scope": "$state",
            "delta": -3
          },
          {
            "kind": "stat",
            "target": "mood",
            "scope": "$state",
            "delta": -2
          }
        ],
        "newsTemplateId": "ev.flood_warning.ignore",
        "advisorReactions": {
          "politics": "If the river rises, so will the criticism.",
          "finance": "No cost, for now."
        }
      }
    ],
    "chains": [
      {
        "eventId": "flood_aftermath",
        "delayTicks": 3,
        "ifChoice": "ignore"
      }
    ]
  },
